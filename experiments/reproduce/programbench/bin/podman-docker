#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -eq 3 && "$1" == "info" && "$2" == "--format" && "$3" == "{{.Architecture}}" ]]; then
  exec podman info --format "{{.Host.Arch}}"
fi

if [[ "$#" -gt 0 && "$1" == "run" ]]; then
  extra_run_args=()
  if [[ "${PROGRAMBENCH_PODMAN_DOCKER_CALLER:-}" == "docker-shim" ]]; then
    extra_run_args+=(
      --network host
      -v /home/winnieyangwn/swarmchat/experiments/reproduce/programbench/wheelhouse:/opt/programbench-wheelhouse:ro
      -e PIP_NO_INDEX=1
      -e PIP_FIND_LINKS=/opt/programbench-wheelhouse
      -e PIP_DISABLE_PIP_VERSION_CHECK=1
      -e PIP_ROOT_USER_ACTION=ignore
    )
  fi

  exec podman run \
    "${extra_run_args[@]}" \
    -v /usr/local/bin/codex_cli:/usr/local/bin/codex_cli:ro \
    -v /home/winnieyangwn/swarmchat/experiments/reproduce/programbench/etc-codex:/etc/codex:ro \
    -v /home/winnieyangwn/swarmchat/experiments/reproduce/programbench/fbcode-lib-min:/usr/local/fbcode/platform010/lib:ro \
    -v /home/winnieyangwn/swarmchat/experiments/reproduce/programbench/codex-home:/home/agent/.codex \
    "${@:2}"
fi

if [[ "$#" -ge 8 && "$1" == "exec" && "$2" == "-i" && "$4" == "tar" && "$5" == "-C" ]]; then
  exec podman exec -i "$3" tar --no-same-owner "${@:5}"
fi

exec podman "$@"
