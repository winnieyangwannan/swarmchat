#!/bin/sh
set -eu

agent_dir=/opt/agent
lib_path="$agent_dir:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib64:/usr/lib64:/lib:/usr/lib"
release_bin=/home/agent/.codex/packages/meta-dotslash/releases/42c24d3d1610b2dcfbb02ec19a57bd7a1f4c82fbf16f6597ad83edf202ffd0b3/bin/codex

export PATH="$agent_dir${PATH:+:$PATH}"

if [ "${CODEX_HOME:-}" = "/agent-home" ]; then
  export HOME=/agent-home
  sqlite_home="${CODEX_SQLITE_HOME:-/tmp/codex-sqlite}"
  mkdir -p "$sqlite_home"
  chmod 700 "$sqlite_home" 2>/dev/null || true
  export CODEX_SQLITE_HOME="$sqlite_home"
fi

if [ -d /home/agent/.codex/packages/meta-dotslash ]; then
  mkdir -p /agent-home/packages
  if [ ! -e /agent-home/packages/meta-dotslash ]; then
    ln -s /home/agent/.codex/packages/meta-dotslash /agent-home/packages/meta-dotslash
  fi
fi

if [ -x "$release_bin" ]; then
  codex_bin="$release_bin"
else
  codex_bin="$agent_dir/codex"
fi

exec "$agent_dir/ld-linux-x86-64.so.2" --library-path "$lib_path" "$codex_bin" "$@"
